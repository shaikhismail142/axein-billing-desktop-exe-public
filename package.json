{
  "name": "shop-billing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev -p 3000",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start -p 3000",
    "lint": "node ./node_modules/next/dist/bin/next lint",
    "desktop:preflight": "node ./desktop/scripts/desktop-preflight.mjs",
    "desktop:web:dev": "node ./desktop/scripts/run-next-dev.mjs",
    "desktop:web:build": "node ./desktop/scripts/run-next-build.mjs",
    "desktop:prepare-runtime": "node ./desktop/scripts/prepare-runtime.mjs",
    "desktop:runtime:start": "node ./desktop/scripts/run-local-runtime.mjs",
    "desktop:bundle-node": "node ./desktop/scripts/prepare-node-runtime.mjs",
    "desktop:lan:selftest": "node ./desktop/scripts/lan-security-selftest.mjs",
    "desktop:smoke": "node ./desktop/scripts/smoke-test-runtime.mjs",
    "desktop:keygen:selftest": "node ./desktop/scripts/keygen-selftest.mjs",
    "desktop:db:migrate": "node ./desktop/scripts/apply-migrations.mjs",
    "desktop:release:metadata": "node ./desktop/scripts/release-metadata.mjs",
    "desktop:release:verify": "node ./desktop/scripts/verify-windows-installer.mjs",
    "desktop:release:windows": "npm run desktop:build && npm run desktop:release:metadata && npm run desktop:release:verify -- --strict",
    "desktop:tauri": "node ./node_modules/@tauri-apps/cli/tauri.js",
    "desktop:dev": "npm run desktop:tauri -- dev --config ./desktop/src-tauri/tauri.conf.json",
    "desktop:build": "npm run desktop:bundle-node && npm run desktop:tauri -- build --config ./desktop/src-tauri/tauri.conf.json",
    "desktop:build:macos": "npm run desktop:bundle-node && npm run desktop:tauri -- build --config ./desktop/src-tauri/tauri.macos.conf.json",
    "desktop:keygen:dev": "npm run desktop:tauri -- dev --config ./desktop/src-tauri/tauri.keygen.conf.json",
    "desktop:keygen:build": "npm run desktop:bundle-node && npm run desktop:tauri -- build --config ./desktop/src-tauri/tauri.keygen.conf.json",
    "desktop:keygen:build:macos": "npm run desktop:bundle-node && npm run desktop:tauri -- build --config ./desktop/src-tauri/tauri.keygen.macos.conf.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.637.0",
    "@electric-sql/pglite": "^0.3.15",
    "@pdf-lib/fontkit": "^1.1.1",
    "archiver": "^6.0.2",
    "archiver-zip-encrypted": "^1.0.11",
    "bcryptjs": "^3.0.2",
    "csv-parse": "5.6.0",
    "csv-stringify": "^6.6.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.544.0",
    "luxon": "^3.7.2",
    "next": "14.2.5",
    "next-themes": "^0.4.6",
    "node-stream-zip": "^1.15.0",
    "nodemailer": "^7.0.6",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "puppeteer": "^23.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.2.1",
    "tar-stream": "^3.1.7",
    "unzipper": "^0.12.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "20.14.12",
    "@types/pg": "8.11.6",
    "@types/react": "18.3.3",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "autoprefixer": "^10.4.21",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "typescript": "5.9.2"
  }
}
