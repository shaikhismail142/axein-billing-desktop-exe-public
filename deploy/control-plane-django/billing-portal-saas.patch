+import base64
+import hashlib
+import hmac
+import json
+import secrets
+import time
+import urllib.error
+import urllib.request
+
+from django.conf import settings
+from django.utils import timezone
+
+
+class ControlPlaneError(RuntimeError):
+    pass
+
+
+def _signature(secret, method, path, timestamp, nonce, raw_body):
+    digest = hashlib.sha256(raw_body).hexdigest()
+    canonical = "\n".join((method.upper(), path, timestamp, nonce, digest)).encode()
+    signed = hmac.new(secret.encode(), canonical, hashlib.sha256).digest()
+    return base64.urlsafe_b64encode(signed).rstrip(b"=").decode()
+
+
+def control_plane_request(method, path, payload=None):
+    secret = settings.AXEIN_SAAS_CONTROL_SECRET.strip()
+    if not secret:
+        raise ControlPlaneError("AXEIN_SAAS_CONTROL_SECRET is not configured")
+    raw_body = b"" if payload is None else json.dumps(payload, separators=(",", ":")).encode()
+    timestamp = str(int(time.time()))
+    nonce = secrets.token_urlsafe(24)
+    headers = {
+        "Accept": "application/json",
+        "Content-Type": "application/json",
+        "X-AxEin-Client": settings.AXEIN_SAAS_CONTROL_CLIENT,
+        "X-AxEin-Timestamp": timestamp,
+        "X-AxEin-Nonce": nonce,
+        "X-AxEin-Signature": _signature(secret, method, path, timestamp, nonce, raw_body),
+    }
+    url = settings.AXEIN_SAAS_BASE_URL.rstrip("/") + path
+    request = urllib.request.Request(url, data=raw_body if method != "GET" else None, headers=headers, method=method)
+    try:
+        with urllib.request.urlopen(request, timeout=settings.AXEIN_SAAS_CONTROL_TIMEOUT_SECONDS) as response:
+            return json.loads(response.read().decode() or "{}")
+    except urllib.error.HTTPError as exc:
+        detail = exc.read().decode(errors="replace")[:500]
+        raise ControlPlaneError(f"SaaS returned HTTP {exc.code}: {detail}") from exc
+    except (urllib.error.URLError, TimeoutError) as exc:
+        raise ControlPlaneError(f"SaaS is unavailable: {exc}") from exc
+
+
+def sync_tenant(tenant):
+    company = tenant.company
+    payload = {
+        "code": tenant.code,
+        "name": company.legal_name,
+        "legal_name": company.legal_name,
+        "business_type": tenant.business_template,
+        "tenant_status": tenant.status,
+        "plan_code": tenant.plan_code,
+        "plan_status": tenant.status,
+        "starts_at": tenant.starts_at.isoformat() if tenant.starts_at else None,
+        "ends_at": tenant.ends_at.isoformat() if tenant.ends_at else None,
+        "user_limit": tenant.user_limit,
+        "modules": tenant.modules,
+    }
+    method = "PATCH" if tenant.operational_business_id else "POST"
+    if tenant.operational_business_id:
+        payload["business_id"] = tenant.operational_business_id
+    try:
+        result = control_plane_request(method, "/api/platform/tenants", payload)
+        if not tenant.operational_business_id:
+            tenant.operational_business_id = int(result["business_id"])
+        tenant.sync_status = "synced"
+        tenant.last_synced_at = timezone.now()
+        tenant.last_sync_error = ""
+        tenant.save(update_fields=("operational_business_id", "sync_status", "last_synced_at", "last_sync_error", "updated_at"))
+        return result
+    except (ControlPlaneError, KeyError, TypeError, ValueError) as exc:
+        tenant.sync_status = "failed"
+        tenant.last_sync_error = str(exc)[:2000]
+        tenant.save(update_fields=("sync_status", "last_sync_error", "updated_at"))
+        if isinstance(exc, ControlPlaneError):
+            raise
+        raise ControlPlaneError(f"Invalid SaaS response: {exc}") from exc
