+    @admin.action(description="Provision or sync selected tenants to AxEin SaaS")
+    def sync_selected_tenants(self, request, queryset):
+        succeeded = 0
+        failures = []
+        for tenant in queryset.select_related("company"):
+            try:
+                sync_tenant(tenant)
+                succeeded += 1
+            except ControlPlaneError as exc:
+                failures.append(f"{tenant.code}: {exc}")
+        if succeeded:
+            self.message_user(request, f"Synced {succeeded} SaaS tenant(s).", messages.SUCCESS)
+        if failures:
+            self.message_user(request, "; ".join(failures), messages.ERROR)
