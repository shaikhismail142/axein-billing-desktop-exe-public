{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AxEin Billing Desktop",
  "version": "1.0.2",
  "identifier": "com.axein.billing.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:web:dev",
    "devUrl": "http://127.0.0.1:3001",
    "beforeBuildCommand": "npm run desktop:web:build && npm run desktop:prepare-runtime"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "AxEin Billing",
        "url": "http://127.0.0.1:3199",
        "width": 1366,
        "height": 860,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "../runtime"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerHooks": "nsis-hooks.billing.nsh"
      }
    }
  }
}
